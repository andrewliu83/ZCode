{
  "name": "@zcode/thinkrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./spec": "./src/spec/index.ts",
    "./vocabulary": "./src/spec/vocabulary.ts",
    "./rules": "./src/rules.ts"
  },
  "scripts": {
